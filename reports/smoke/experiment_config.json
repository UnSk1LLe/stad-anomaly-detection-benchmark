{
  "name": "smoke",
  "grid": "smoke",
  "seeds": [
    0,
    1
  ],
  "param_budget": 60000,
  "alarm_budget_per_hour": 1.0,
  "half_life_min": 15.0,
  "persistence": 3,
  "node_reduce": "max",
  "primary_metric": "padf",
  "save_checkpoints": true,
  "out_dir": "reports/smoke",
  "datasets": {
    "synthetic": {
      "loader": "synthetic",
      "kwargs": {
        "stations": 10,
        "lanes": 3,
        "days": 8,
        "step_min": 1.0,
        "n_events": 40,
        "amplitude": 0.6,
        "window": 12,
        "seed": 0
      }
    }
  },
  "train": {
    "epochs": 6,
    "batch_size": 32,
    "lr": 0.002,
    "patience": 3,
    "device": "auto"
  }
}