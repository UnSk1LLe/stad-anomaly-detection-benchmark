{
  "name": "ft_aed_cv",
  "grid": "core",
  "seeds": [
    0
  ],
  "param_budget": 150000,
  "alarm_budget_per_hour": 0.25,
  "half_life_min": 15.0,
  "persistence": 3,
  "primary_metric": "padf",
  "out_dir": "reports/ft_aed_cv",
  "datasets": {
    "fold0": {
      "loader": "ft-aed",
      "from_file": "configs/data/ft_aed.yaml",
      "kwargs": {
        "fold": 0
      }
    },
    "fold1": {
      "loader": "ft-aed",
      "from_file": "configs/data/ft_aed.yaml",
      "kwargs": {
        "fold": 1
      }
    },
    "fold2": {
      "loader": "ft-aed",
      "from_file": "configs/data/ft_aed.yaml",
      "kwargs": {
        "fold": 2
      }
    },
    "fold3": {
      "loader": "ft-aed",
      "from_file": "configs/data/ft_aed.yaml",
      "kwargs": {
        "fold": 3
      }
    }
  },
  "train": {
    "epochs": 12,
    "batch_size": 64,
    "lr": 0.001,
    "weight_decay": 1e-05,
    "grad_clip": 1.0,
    "patience": 4,
    "d_steps": 1,
    "device": "auto"
  }
}